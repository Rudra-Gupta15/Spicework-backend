# Inventory/Auth PostgreSQL Database Configuration (users / roles / platform_user_roles)
# Named distinctly from PG_* so it can never collide with backend/db.py's audit-DB engine toggle.
# Copy this file to backend/.env and fill in real values — .env is gitignored.
INVENTORY_PG_HOST=
INVENTORY_PG_PORT=5432
INVENTORY_PG_USER=
INVENTORY_PG_PASSWORD=
INVENTORY_PG_DATABASE=
