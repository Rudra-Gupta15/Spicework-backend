# Inventory/Auth PostgreSQL Database Configuration (users / roles / platform_user_roles)
# Named distinctly from PG_* so it can never collide with backend/db.py's audit-DB engine toggle.
# Copy this file to backend/.env and fill in real values — .env is gitignored.
INVENTORY_PG_HOST=
INVENTORY_PG_PORT=5432
INVENTORY_PG_USER=
INVENTORY_PG_PASSWORD=
INVENTORY_PG_DATABASE=

# JWT signing key for login/register. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required — the backend refuses to sign tokens with an empty key. Rotating
# this invalidates every outstanding token at once.
JWT_SECRET=
# How long a login lasts, in minutes. Tokens are stateless, so there is no
# server-side revoke — this is the only thing that expires a stolen token.
JWT_EXPIRE_MINUTES=720
